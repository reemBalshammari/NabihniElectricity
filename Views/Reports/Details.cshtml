@model NabihniElectricity.Models.Report

@{
    ViewData["Title"] = "تفاصيل البلاغ";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-success">
            تفاصيل البلاغ
        </h1>

        <p class="text-light">
            عرض جميع بيانات البلاغ.
        </p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-lg rounded-4 p-4"
                 style="background:#11243d;">

                <table class="table table-dark table-hover align-middle">

                    <tbody>

                        <tr>
                            <th width="35%">اسم المبلغ</th>
                            <td>@Model.ReporterName</td>
                        </tr>

                        <tr>
                            <th>رقم الجوال</th>
                            <td>@Model.Phone</td>
                        </tr>

                        <tr>
                            <th>الموقع</th>
                            <td>@Model.Location</td>
                        </tr>

                        <tr>
                            <th>نوع البلاغ</th>
                            <td>@Model.ReportType</td>
                        </tr>

                        <tr>
                            <th>الوصف</th>
                            <td>@Model.Description</td>
                        </tr>

                        <tr>
                            <th>تاريخ البلاغ</th>
                            <td>@Model.CreatedAt.ToString("yyyy/MM/dd")</td>
                        </tr>

                        <tr>
                            <th>الحالة</th>
                            <td>
                                <span class="badge bg-success">
                                    @Model.Status
                                </span>
                            </td>
                        </tr>

                    </tbody>

                </table>

                <div class="d-flex gap-2 mt-3">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-success rounded-pill px-4">

                        ✏️ تعديل

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger rounded-pill px-4">

                        🗑 حذف

                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-light rounded-pill px-4">

                        رجوع

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>