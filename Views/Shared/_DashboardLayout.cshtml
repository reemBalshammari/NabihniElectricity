@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using NabihniElectricity.Models
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@inject IViewLocalizer Localizer

@{
    var isRTL = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var htmlDir = isRTL ? "rtl" : "ltr";
    var htmlLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}

<!DOCTYPE html>
<html lang="@htmlLang" dir="@htmlDir">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @SharedLocalizer["StoreSystem"]</title>

    @if (isRTL)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        body{
            background:#062b2a;
            overflow-x:hidden;
        }

        .sidebar{

            width:260px;
            height:100vh;
            position:fixed;
            top:0;

            @(isRTL ? "right:-260px;" : "left:-260px;")

            background:linear-gradient(180deg,#0F2E2C,#143B39,#0F2E2C);

            transition:.35s;

            z-index:9999;

        }

        .sidebar.show{

            @(isRTL ? "right:0;" : "left:0;")

        }

        .sidebar .nav-link{

            color:#dfffe0;
            padding:13px 20px;
            margin:6px 12px;
            border-radius:10px;
            transition:.3s;

        }

        .sidebar .nav-link:hover{

            background:rgba(95,255,87,.18);
            color:white;

        }

        .main-content{

            min-height:100vh;

        }

    </style>

</head>

<body>

<aside class="sidebar">

<div class="text-center p-4 border-bottom">

<h4 class="text-white">

<i class="bi bi-lightning-charge-fill text-success"></i>

@SharedLocalizer["StoreSystem"]

</h4>

<small class="text-light">

@(isRTL ? "لوحة التحكم" : "Dashboard")

</small>

</div>

<ul class="nav flex-column mt-3">

<li class="nav-item">

    <a class="nav-link"
       asp-controller="Home"
       asp-action="Index">

        <i class="bi bi-house-door-fill"></i>

        @(isRTL ? "الرئيسية" : "Home")

    </a>

</li>
<li class="nav-item">

    <a class="nav-link"
       asp-controller="Reports"
       asp-action="Index">

        <i class="bi bi-clipboard-data-fill"></i>

        @(isRTL ? "البلاغات" : "Reports")

    </a>

</li>

<li class="nav-item">

    <a class="nav-link"
       asp-controller="Home"
       asp-action="ReportTypes">

        <i class="bi bi-lightning-charge-fill"></i>

        @(isRTL ? "أنواع البلاغات" : "Report Types")

    </a>

</li>

<li class="nav-item">

    <a class="nav-link"
       asp-controller="Home"
       asp-action="Contact">

        <i class="bi bi-envelope-fill"></i>

        @(isRTL ? "تواصل معنا" : "Contact Us")

    </a>

</li>

<li class="nav-item mt-4">

    <form asp-controller="Account"
          asp-action="Logout"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="nav-link text-danger border-0 bg-transparent w-100 text-start">

            <i class="bi bi-box-arrow-right"></i>

            @(isRTL ? "تسجيل الخروج" : "Logout")

        </button>

    </form>

</li>

</ul>

</aside>

<div class="main-content d-flex flex-column">

<header class="shadow-sm p-3"
        style="background:linear-gradient(90deg,#0F2E2C,#143B39,#0F2E2C);
               border-bottom:1px solid rgba(124,255,87,.18);">

<div class="d-flex justify-content-between align-items-center">

<button class="btn"
        onclick="toggleSidebar()"
        style="
        background:#7CFF57;
        color:#143B39;
        border:none;
        width:48px;
        height:48px;
        border-radius:12px;">

    <i class="bi bi-list fs-3 fw-bold"></i>

</button>

<h4 class="mb-0 text-white fw-bold">

    @ViewData["Title"]

</h4>

<partial name="_SelectLanguage" />

<div class="vr"></div>
</div>

</header>

<main class="p-4 flex-grow-1">

    @RenderBody()

</main>

<footer class="bg-white text-center p-3 border-top">

    <small>

        © 2026
        @(isRTL ? "نبهني كهرباء | جميع الحقوق محفوظة"
                : "Nabihni Electricity | All Rights Reserved")

    </small>

</footer>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

<script>

function toggleSidebar(){

    document.querySelector(".sidebar").classList.toggle("show");

}

document.addEventListener("click",function(e){

    const sidebar=document.querySelector(".sidebar");

    const button=e.target.closest("button");

    if(!sidebar.contains(e.target) && !button){

        sidebar.classList.remove("show");

    }

});

</script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>