@using System.Globalization
@model NabihniElectricity.Models.RegisterViewModel

@{
    var isArabic = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = isArabic ? "إنشاء حساب" : "Register";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-5 col-md-7">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <div class="mx-auto mb-3"
                             style="width:80px;height:80px;
                             border-radius:50%;
                             background:linear-gradient(135deg,#7CFF57,#D9FF63);
                             display:flex;
                             align-items:center;
                             justify-content:center;
                             box-shadow:0 0 25px rgba(124,255,87,.45);">

                            <i class="bi bi-person-plus-fill"
                               style="font-size:34px;color:#143B39;"></i>

                        </div>

                        <h2 class="fw-bold mb-1">
                            @(isArabic ? "إنشاء حساب" : "Create Account")
                        </h2>

                        <p class="text-muted">
                            @(isArabic
                                ? "أنشئ حساباً جديداً في نظام نبهني كهرباء"
                                : "Create a New Account in Nabihni Electricity System")
                        </p>

                    </div>

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                @(isArabic ? "الاسم الأول" : "First Name")
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control rounded-3 py-2"
                                   placeholder="@(isArabic ? "أدخل الاسم الأول" : "Enter First Name")" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                @(isArabic ? "الاسم الأخير" : "Last Name")
                            </label>

                            <input asp-for="LastName"
                                   class="form-control rounded-3 py-2"
                                   placeholder="@(isArabic ? "أدخل الاسم الأخير" : "Enter Last Name")" />

                            <span asp-validation-for="LastName"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                @(isArabic ? "البريد الإلكتروني" : "Email")
                            </label>

                            <input asp-for="Email"
                                   class="form-control rounded-3 py-2"
                                   placeholder="@(isArabic ? "أدخل البريد الإلكتروني" : "Enter Email")" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                @(isArabic ? "كلمة المرور" : "Password")
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control rounded-3 py-2"
                                   placeholder="@(isArabic ? "أدخل كلمة المرور" : "Enter Password")" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>

                        </div>
                        <div class="mb-4">

    <label class="form-label fw-bold">
        @(isArabic ? "تأكيد كلمة المرور" : "Confirm Password")
    </label>

    <input asp-for="ConfirmPaasword"
           type="password"
           class="form-control rounded-3 py-2"
           placeholder="@(isArabic ? "أعد إدخال كلمة المرور" : "Re-enter Password")" />

    <span asp-validation-for="ConfirmPaasword"
          class="text-danger"></span>

</div>

<button type="submit"
        class="btn w-100 fw-bold rounded-3 py-2"
        style="background:linear-gradient(90deg,#7CFF57,#D9FF63);
               color:#143B39;
               border:none;">

    <i class="bi bi-person-plus-fill"></i>

    @(isArabic ? "إنشاء الحساب" : "Create Account")

</button>

<div class="text-center mt-4">

    <span class="text-muted">

        @(isArabic ? "لديك حساب بالفعل؟" : "Already have an account?")

    </span>

    <a asp-action="Login"
       class="fw-bold text-success text-decoration-none">

        @(isArabic ? "تسجيل الدخول" : "Login")

    </a>

</div>

</form>

</div>

</div>

</div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}